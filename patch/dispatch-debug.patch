diff --git a/kernel/hook/arm64/syscall_hook.c b/kernel/hook/arm64/syscall_hook.c
index 7bd6df0..ae83667 100644
--- a/kernel/hook/arm64/syscall_hook.c
+++ b/kernel/hook/arm64/syscall_hook.c
@@ -147,6 +147,14 @@ static int __init ksu_find_ni_syscall_slots(int *out_slots, int max_slots)
 // otherwise it's a spurious call — return -ENOSYS.
 static long __nocfi ksu_syscall_dispatcher(const struct pt_regs *regs)
 {
+    {
+        static int ksu_dbg_disp_cnt;
+        if (ksu_dbg_disp_cnt < 30) {
+            ksu_dbg_disp_cnt++;
+            pr_info("ksu-dbg DISP: syscallno=%d disp=%d x8=%lu\n", regs->syscallno, ksu_dispatcher_nr,
+                    (unsigned long)PT_REGS_ORIG_SYSCALL(regs));
+        }
+    }
     if (regs->syscallno != ksu_dispatcher_nr)
         return -ENOSYS;
 
